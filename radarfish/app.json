{
  "expo": {
    "name": "RadarFish",
    "slug": "radarfish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.radarfish.personal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.radarfish.personal"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "radarfish",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RadarFish usa tu ubicación para mostrarte en el mapa y sus condiciones."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RadarFish accede a tus fotos para adjuntarlas a las capturas.",
          "cameraPermission": "RadarFish usa la cámara para fotografiar capturas."
        }
      ],
      "expo-notifications"
    ]
  }
}
